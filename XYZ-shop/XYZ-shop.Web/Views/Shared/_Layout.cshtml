@using System.Globalization
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/steam/recommendations.css">
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.js"></script>
    <script src="~/js/notification.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</head>
<body>
    @inject XYZ_shop.Application.Abstractions.Services.IAuthService AuthService
    <div class="notifications"></div>
    <header class="site-header">
        <div class="topbar">
            <a class="brand" href="/Steam/Index">STEAM</a>

            <nav class="primary-nav">
                <ul class="nav-list">
                    <li class="store-link"><a href="/Steam/Index">@LayoutPage.Nav_Steam</a></li>
                    <li class="catalog-link"><a href="/Steam/Catalog">@LayoutPage.Nav_Catalog</a></li>
                    <li class="community-chat-link"><a href="/Steam/CommunityChat">@LayoutPage.Nav_CommunityChat</a></li>
                    <li><a href="/Steam/Recommendations">@LayoutPage.Nav_Recommendations</a></li>
                    <li><a href="#">@LayoutPage.Nav_About</a></li>
                </ul>
            </nav>

            <div class="topbar-actions">
                @if (AuthService.IsAuthenticated())
                {
                    var avatarUrl = AuthService.GetUser()?.AvatarUrl;
                    if (string.IsNullOrWhiteSpace(avatarUrl))
                    {
                        avatarUrl = "/images/default-avatar.png";
                    }
                    <a class="user-info" href="/Profile">
                        <img class="user-avatar-small" src="@avatarUrl" alt="" />
                        <span class="auth-user">@AuthService.GetUserName()</span>
                    </a>
                    <a class="btn btn--small" href="/Auth/Logout">@LayoutPage.Logout</a>
                }
                else
                {
                    <a class="btn btn--small" href="/Auth/Login">@LayoutPage.Login</a>
                    <a class="btn btn--small" href="/Auth/Registration">@LayoutPage.Register</a>
                }
                <form class="search">
                    <input name="q" type="search" placeholder="@LayoutPage.Search_Placeholder" />
                    <button type="submit">@LayoutPage.Search_Button</button>
                </form>
            </div>
        </div>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="footer">
        <div class="footer-inner">
            <div class="footer-top">
                <div class="footer-logo">STEAM</div>
                <div class="footer-links">
                    <a href="#">@LayoutPage.Footer_About_Company</a>
                    <a href="#">@LayoutPage.Footer_Jobs</a>
                    <a href="#">@LayoutPage.Footer_Steamworks</a>
                    <a href="#">@LayoutPage.Footer_Support</a>
                    <a href="#">@LayoutPage.Footer_Privacy_Policy</a>
                    <a href="#">@LayoutPage.Footer_Legal</a>
                </div>
            </div>

            <div class="footer-bottom">
                <p>
                    @LayoutPage.Footer_Copyright
                </p>
            </div>
        </div>
    </footer>
</body>
</html>
