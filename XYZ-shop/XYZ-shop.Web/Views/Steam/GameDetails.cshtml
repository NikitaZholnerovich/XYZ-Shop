@model GameDetailsViewModel
@using XYZ_shop.Application.Abstractions.Services
@inject IAuthService AuthService
@{
    Layout = "_Layout";
}

@section Scripts {
    <script src="~/js/game-reviews.js" asp-append-version="true"></script>
}

<main class="page">
    <section class="section">
        <div class="game-header">
            <a class="btn" href="/Steam/Catalog">&larr; @GameDetailsPage.Back_To_Catalog</a>
            @if (Model.IsUserAtLeastModerator)
            {
                <a class="btn btn--edit" href="/Steam/EditGame/@Model.Id">✎ @GameDetailsPage.Edit_Game</a>
                <a class="btn btn--edit" href="/Steam/DeleteGame/@Model.Id">@GameDetailsPage.Delete_Game</a>
            }
        </div>
    </section>

    <section class="section">
        <div class="game-container">

            <div class="game-image">
                <img src="@Model.ImageUrl" alt="@Model.Title" />
            </div>

            <div class="game-info">
                <h1 class="game-title">@Model.Title</h1>

                <div class="game-meta">
                    @foreach (var genre in Model.Genres)
                    {
                        <a class="game-genre"
                           asp-controller="Steam"
                           asp-action="Catalog"
                           asp-route-GenreId="@genre.Id">@genre.Name</a>
                    }

                    @if (!string.IsNullOrEmpty(Model.PublisherName) && Model.PublisherId.HasValue)
                    {
                        <a class="game-publisher"
                           asp-controller="Steam"
                           asp-action="Catalog"
                           asp-route-PublisherId="@Model.PublisherId">@Model.PublisherName</a>
                    }
                </div>

                <div class="game-price">
                    @if (Model.Price > 0)
                    {
                        <span>$@Model.Price.ToString("0.00")</span>
                    }
                    else
                    {
                        <span class="free">@GameDetailsPage.Free</span>
                    }
                </div>

                <div class="game-description">
                    <h3>@GameDetailsPage.About_This_Game</h3>
                    <p>@Model.Description</p>
                </div>

                <div class="game-rating-summary">
                    <div class="game-rating-score">
                        @if (Model.AverageRating.HasValue)
                        {
                            <span>@Model.AverageRating.Value.ToString("0.0")</span>
                            <small>/ 10</small>
                        }
                        else
                        {
                            <span>-</span>
                            <small>/ 10</small>
                        }
                    </div>
                    <div class="game-rating-details">
                        <span>@Model.ReviewsCount @GameDetailsPage.Reviews</span>
                        <span>@Model.PositiveReviewsCount @GameDetailsPage.Recommended</span>
                    </div>
                </div>

                <div class="game-actions">
                    <button class="btn btn--primary">@GameDetailsPage.Add_To_Cart</button>
                    <button class="btn">@GameDetailsPage.Add_To_Wishlist</button>
                </div>
            </div>
        </div>
    </section>

    @if (Model.SimilarGames.Any())
    {
        <section class="section">
            <h2 class="section-title">Similar games</h2>
            <div class="cards">
                @foreach (var game in Model.SimilarGames)
                {
                    <article class="card">
                        <div class="card-media">
                            <img src="@game.ImageUrl" alt="@game.Title" />
                        </div>
                        <div class="card-body">
                            <h3 class="card-title">@game.Title</h3>
                            @if (game.Genres.Any())
                            {
                                <div class="feature-genres">
                                    @foreach (var genre in game.Genres)
                                    {
                                        <span class="game-genre">@genre</span>
                                    }
                                </div>
                            }
                            <div class="card-footer">
                                <span class="price">$@game.Price.ToString("0.00")</span>
                                <a class="btn btn--small" href="/Steam/GameDetails/@game.Id">View</a>
                            </div>
                        </div>
                    </article>
                }
            </div>
        </section>
    }

    <section class="section">
        <h2 class="section-title">@GameDetailsPage.Reviews_Title</h2>

        @if (AuthService.IsAuthenticated() && !Model.HasUserReviewed)
        {
            <button type="button" id="show-review-form-btn">@GameDetailsPage.Write_A_Review</button>
            <div id="review-form-container" class="review-form-hidden">
                <form id="review-form" data-game-id="@Model.Id">
                    <textarea id="review-text" placeholder="@GameDetailsPage.Share_Your_Thoughts" maxlength="5000" required></textarea>
                    <input id="review-rating" type="number" min="1" max="10" placeholder="@GameDetailsPage.Rating" required />
                    <div>
                        <button type="submit">@GameDetailsPage.Submit</button>
                        <button type="button" id="cancel-review-btn">@GameDetailsPage.Cancel</button>
                    </div>
                </form>
            </div>
        }

        <div id="reviews-empty" class="catalog-empty" style="@(Model.Reviews.Any() ? "display:none" : null)">
            <h3>@GameDetailsPage.No_Reviews_Yet</h3>
            <p>@GameDetailsPage.Not_Reviewed</p>
        </div>

        <div id="reviews-panel">
            @foreach (var review in Model.Reviews)
            {
                var avatarUrl = string.IsNullOrWhiteSpace(review.AuthorAvatarUrl)
                    ? "/images/default-avatar.png"
                    : review.AuthorAvatarUrl;
                <article class="review-item">
                    <div class="review-item-header">
                        <img class="user-avatar-small" src="@avatarUrl" alt="" />
                        <b>@review.AuthorName</b>
                        <span class="review-rating">@review.Rating / 10</span>
                        <span class="review-dates">
                            <time datetime="@review.CreatedAt.ToString("o")">@review.CreatedAt.ToLocalTime().ToString("g")</time>
                            @if (review.ModifiedAt.HasValue)
                            {
                                <span class="review-edited">
                                    · @GameDetailsPage.Edited
                                    <time datetime="@review.ModifiedAt.Value.ToString("o")">@review.ModifiedAt.Value.ToLocalTime().ToString("g")</time>
                                </span>
                            }
                        </span>
                    </div>
                    <div>@review.Text</div>
                </article>
            }
        </div>
    </section>

    <div id="toast-container"></div>
</main>
