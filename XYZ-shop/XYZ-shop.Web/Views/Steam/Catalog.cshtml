
@model CatalogViewModel
@{
    Layout = "_Layout";
    var pagination = Model.PaginationMetadata;
    var startPage = Math.Max(1, pagination.CurrentPage - 2);
    var endPage = Math.Min(pagination.TotalPages, pagination.CurrentPage + 2);
}
@section Scripts {
    <script src="~/js/catalog-delete-game.js"></script>
}
<main class="page">
    <section class="section">
        <div class="catalog-header">
            <h1 class="page-title">@CatalogPage.Title</h1>
            <div class="catalog-actions">
                <p><a class="btn" href="/Steam/Index">&larr; @CatalogPage.Back_To_Store_Button</a></p>
                @if (Model.IsUserAtLeastModerator)
                {
                    <a class="btn btn--primary" href="/Steam/AddGame">+ @CatalogPage.Add_New_Game_Button</a>
                }
            </div>
        </div>
    </section>

    <section class="section">
        <h2 class="section-title">@CatalogPage.Filter</h2>
        <form method="get" asp-controller="Steam" asp-action="Catalog" class="catalog-filter">
            <div class="form-group">
                <label>@CatalogPage.Genre</label>
                <select name="GenreId" class="form-control">
                    <option value="">@CatalogPage.All_Genres</option>
                    @foreach (var genre in Model.GameGenres)
                    {
                        <option value="@genre.Value" selected="@(Model.Filter.GenreId?.ToString() == genre.Value ? "selected" : null)">
                            @genre.Text
                        </option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label>@CatalogPage.Publisher</label>
                <select name="PublisherId" class="form-control">
                    <option value="">@CatalogPage.All_Publishers</option>
                    @foreach (var publisher in Model.Publishers)
                    {
                        <option value="@publisher.Value" selected="@(Model.Filter.PublisherId?.ToString() == publisher.Value ? "selected" : null)">
                            @publisher.Text
                        </option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label>@CatalogPage.Max_Price</label>
                <input type="number" name="MaxPrice" step="0.01" class="form-control"
                       value="@Model.Filter.MaxPrice" />
            </div>

            <div class="form-group">
                <label>@CatalogPage.Sort_By</label>
                <select name="SortBy" class="form-control">
                    <option value="">@CatalogPage.Default</option>
                    <option value="Title" selected="@(Model.Filter.SortBy == "Title" ? "selected" : null)">@CatalogPage.Title_Sort</option>
                    <option value="Price" selected="@(Model.Filter.SortBy == "Price" ? "selected" : null)">@CatalogPage.Price_Sort</option>
                </select>
            </div>

            <div class="form-group">
                <label>@CatalogPage.Direction</label>
                <select name="SortDirection" class="form-control">
                    <option value="asc" selected="@(!string.Equals(Model.Filter.SortDirection, "desc", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@CatalogPage.Ascending</option>
                    <option value="desc" selected="@(string.Equals(Model.Filter.SortDirection, "desc", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@CatalogPage.Descending</option>
                </select>
            </div>

            <input type="hidden" name="PageSize" value="@Model.Filter.PageSize" />

            <div class="form-actions">
                <button type="submit" class="btn btn--primary">@CatalogPage.Apply</button>
                <a href="/Steam/Catalog" class="btn">@CatalogPage.Reset</a>
                @if (Model.IsUserAtLeastModerator)
                {
                    <button type="button"
                            class="remove-game-card btn"
                            disabled>
                        @CatalogPage.Delete_Game
                    </button>
                }
            </div>
        </form>
    </section>

    <section class="section">
        <h2 class="section-title">@CatalogPage.All_Games (@pagination.TotalCount)</h2>

        @if (Model.Games.Any())
        {
            <div class="cards">
                @foreach (var game in Model.Games)
                {
                    <article class="card" data-id="@game.Id">
                        <div class="card-media">
                            <img src="@game.ImageUrl" alt="@game.Title" />
                        </div>
                        <div class="card-body">
                            <h3 class="card-title">@game.Title</h3>
                            @if (game.Genres != null && game.Genres.Any())
                            {
                                <div class="feature-genres">
                                    @foreach (var genre in game.Genres)
                                    {
                                        <span class="game-genre">@genre</span>
                                    }
                                </div>
                            }
                            <div class="card-footer">
                                <span class="price">$@game.Price.ToString("0.00")</span>
                                <div class="card-buttons">
                                    <a class="btn btn--small" href="/Steam/GameDetails/@game.Id">@CatalogPage.View</a>
                                    <button class="btn-cart btn--small" type="button">@CatalogPage.Add_To_Cart</button>
                                </div>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="catalog-empty">
                <h3>@CatalogPage.No_Games_Found</h3>
                <p>@CatalogPage.Try_Changing_Filters</p>
            </div>
        }

        @if (pagination.TotalPages > 1)
        {
            <nav class="catalog-pagination" aria-label="Catalog pages">
                @if (pagination.HasPreviousPage)
                {
                    <a class="btn"
                       asp-controller="Steam"
                       asp-action="Catalog"
                       asp-route-GenreId="@Model.Filter.GenreId"
                       asp-route-PublisherId="@Model.Filter.PublisherId"
                       asp-route-MaxPrice="@Model.Filter.MaxPrice"
                       asp-route-SortBy="@Model.Filter.SortBy"
                       asp-route-SortDirection="@Model.Filter.SortDirection"
                       asp-route-Page="@(pagination.CurrentPage - 1)"
                       asp-route-PageSize="@Model.Filter.PageSize">@CatalogPage.Prev</a>
                }

                @for (var pageNumber = startPage; pageNumber <= endPage; pageNumber++)
                {
                    <a class="btn @(pageNumber == pagination.CurrentPage ? "active" : "")"
                       asp-controller="Steam"
                       asp-action="Catalog"
                       asp-route-GenreId="@Model.Filter.GenreId"
                       asp-route-PublisherId="@Model.Filter.PublisherId"
                       asp-route-MaxPrice="@Model.Filter.MaxPrice"
                       asp-route-SortBy="@Model.Filter.SortBy"
                       asp-route-SortDirection="@Model.Filter.SortDirection"
                       asp-route-Page="@pageNumber"
                       asp-route-PageSize="@Model.Filter.PageSize">@pageNumber</a>
                }

                @if (pagination.HasNextPage)
                {
                    <a class="btn"
                       asp-controller="Steam"
                       asp-action="Catalog"
                       asp-route-GenreId="@Model.Filter.GenreId"
                       asp-route-PublisherId="@Model.Filter.PublisherId"
                       asp-route-MaxPrice="@Model.Filter.MaxPrice"
                       asp-route-SortBy="@Model.Filter.SortBy"
                       asp-route-SortDirection="@Model.Filter.SortDirection"
                       asp-route-Page="@(pagination.CurrentPage + 1)"
                       asp-route-PageSize="@Model.Filter.PageSize">@CatalogPage.Next</a>
                }
            </nav>
        }
    </section>
</main>
