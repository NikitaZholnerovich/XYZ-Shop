
@model EditGameViewModel
@{
    Layout = "_Layout";
}
<main class="page">
    <section class="section">
        <h1 class="page-title">@EditGamePage.Title</h1>
        <div class="catalog-header">
            <p><a class="btn" href="/Steam/GameDetails/@Model.Id">&larr; @EditGamePage.Back_To_Game</a></p>
        </div>
    </section>

    <section class="section">
        <form method="post" asp-controller="Steam" asp-action="EditGame">
            @Html.HiddenFor(x => x.Id)

            <div class="form-group">
                @Html.LabelFor(x => x.Title, EditGamePage.Label_Title)
                @Html.ValidationMessageFor(x => x.Title)
                @Html.TextBoxFor(x => x.Title, new {
                    @class = "form-control",
                    placeholder = EditGamePage.Placeholder_Title,
                    required = "required"
                })
            </div>

            <div class="form-group">
                @Html.LabelFor(x => x.ImageUrl, EditGamePage.Image_URL)
                @Html.ValidationMessageFor(x => x.ImageUrl)
                @Html.TextBoxFor(x => x.ImageUrl, new {
                    @class = "form-control",
                    placeholder = "https://example.com/image.jpg",
                    type = "url"
                })
            </div>

            <div class="form-group">
                @Html.LabelFor(x => x.Description, EditGamePage.Description)
                @Html.ValidationMessageFor(x => x.Description)
                @Html.TextAreaFor(x => x.Description, new {
                    @class = "form-control",
                    rows = "5",
                    placeholder = EditGamePage.Placeholder_Description
                })
            </div>

            <div class="form-group">
                @Html.LabelFor(x => x.Price, EditGamePage.Price)
                @Html.ValidationMessageFor(x => x.Price)
                @Html.TextBoxFor(x => x.Price, new {
                    @class = "form-control",
                    placeholder = "0.00",
                    type = "number",
                    step = "0.01",
                    required = "required"
                })
            </div>

            <div class="form-group">
                @Html.LabelFor(x => x.SelectedGenreIds, EditGamePage.Genres)
                <select id="SelectedGenreIds" name="SelectedGenreIds" class="form-control" multiple required>
                    @foreach (var genre in Model.AllGenres)
                    {
                        <option value="@genre.Value" selected="@(Model.SelectedGenreIds.Contains(int.Parse(genre.Value ?? "0")) ? "selected" : null)">
                            @genre.Text
                        </option>
                    }
                </select>
                <small class="form-text text-muted">@EditGamePage.Hold_Ctrl</small>
            </div>

            <div class="form-group">
                @Html.LabelFor(x => x.PublisherId, EditGamePage.Publisher)
                <select id="PublisherId" name="PublisherId" class="form-control">
                    @foreach (var publisher in Model.Publishers)
                    {
                        <option value="@publisher.Value" selected="@(Model.PublisherId.ToString() == publisher.Value ? "selected" : null)">
                            @publisher.Text
                        </option>
                    }
                </select>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn--primary">@EditGamePage.Save_Game</button>
                <a href="/Steam/GameDetails/@Model.Id" class="btn">@EditGamePage.Cancel</a>
            </div>
        </form>
    </section>
</main>
