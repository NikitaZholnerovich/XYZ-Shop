# Copy to .env and fill in real values. Do not commit .env.

# SQL Server SA password (must meet MSSQL complexity rules)
MSSQL_SA_PASSWORD=Your_strong_Password1

# JWT signing key (at least 32 characters)
JWT_KEY=change-me-to-a-long-random-secret-key!!

JWT_ISSUER=XYZ-shop
JWT_AUDIENCE=XYZ-shop
JWT_EXPIRE_MINUTES=60

# RAWG Games API key: https://rawg.io/apidocs
RAWG_API_KEY=your-rawg-api-key
